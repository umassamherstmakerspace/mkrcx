# Comma-separated frontend origins that may receive OAuth login callbacks.
# Use HTTPS except for loopback development. Configure the exact origin for
# each deployment; for example https://mkr.cx or https://staging.mkr.cx.
LEASH_LOGIN_RETURN_ORIGINS=https://mkr.cx

# Optional Discord incoming webhook for authenticated /note submissions.
# Keep this value in the deployment secret, never in source control.
DISCORD_NOTES_WEBHOOK_URL=
