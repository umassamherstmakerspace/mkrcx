# Comma-separated frontend origins that may receive OAuth login callbacks.
# Use HTTPS except for loopback development. Configure the exact origin for
# each deployment; for example https://mkr.cx or https://staging.mkr.cx.
LEASH_LOGIN_RETURN_ORIGINS=https://mkr.cx

# Optional Discord incoming webhook for authenticated /note submissions.
# Keep this value in the deployment secret, never in source control.
DISCORD_NOTES_WEBHOOK_URL=

# Optional DocuSign Connect receiver. Configure all four values together.
# The HMAC secret is generated/configured in DocuSign Connect and must remain
# in a deployment Secret. Include envelope and recipient data in JSON Connect
# notifications so the completed Member signer can be matched to mkr.cx.
DOCUSIGN_CONNECT_HMAC_SECRET=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_WAIVER_SUBJECT_PREFIX="UMass Makerspace Use Agreement |"
DOCUSIGN_WAIVER_RECIPIENT_ROLE=Member
