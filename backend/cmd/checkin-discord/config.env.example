# Non-secret endpoint shape; replace 17 with the numeric signin feed ID.
MKRCX_SIGNIN_FEED_ITEMS_URL=https://mkr.cx/api/feeds/17/items

# Secrets intentionally blank. Supply them only in the local process environment or an approved
# secret store; never commit populated values.
MKRCX_SIGNIN_API_KEY=
DISCORD_SIGNIN_WEBHOOK_URL=

CHECKIN_DISCORD_POLL_INTERVAL=2s
CHECKIN_DISCORD_HTTP_TIMEOUT=10s
